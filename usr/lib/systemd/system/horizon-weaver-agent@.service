[Unit]
Description=Horizon Weaver agent %i
PartOf=horizon-weaver.target
After=network-online.target horizon-weaver-gateway.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I /usr/libexec/horizon-weaver/agent.py %i
DynamicUser=yes
User=hw-%i
StateDirectory=horizon-weaver/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/horizon-weaver/%i
LoadCredential=gateway-key:/etc/horizon-weaver/credentials/gateway-key
UMask=0077
Restart=no
RestartPreventExitStatus=78
RuntimeMaxSec=300
TimeoutStopSec=10
KillMode=control-group
MemoryMax=256M
CPUQuota=25%
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/run/docker.sock -/run/podman -/var/lib/docker -/sysroot
StandardOutput=journal
StandardError=journal
