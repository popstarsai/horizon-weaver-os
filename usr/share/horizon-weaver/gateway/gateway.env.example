# Copy to /etc/horizon-weaver/gateway/gateway.env, root:root mode 0600.
# Replace every CHANGE_ME value before starting the service.
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:CHANGE_ME
LITELLM_MASTER_KEY=sk-CHANGE_ME
# OpenAI-compatible endpoints from an operator-managed local model runtime.
# Ports and model names below are examples, not llmman defaults.
HW_LOCAL_MODEL=openai/CHANGE_ME_LOCAL_MODEL
HW_LOCAL_API_BASE=http://127.0.0.1:8000/v1
HW_LOCAL_API_KEY=unused
HW_BACKUP_MODEL=openai/CHANGE_ME_BACKUP_MODEL
HW_BACKUP_API_BASE=http://127.0.0.1:8001/v1
HW_BACKUP_API_KEY=unused
# Used only by config.remote-example.yaml. Native LiteLLM provider prefixes work
# as well; adjust api_base for that provider. No wildcard model routes are shipped.
HW_REMOTE_MODEL=openai/CHANGE_ME_REMOTE_MODEL
HW_REMOTE_API_BASE=https://CHANGE_ME_PROVIDER/v1
HW_REMOTE_API_KEY=CHANGE_ME
